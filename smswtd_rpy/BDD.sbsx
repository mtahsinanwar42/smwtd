			<_constant type="a">0</_constant>
			<_itsBody type="p"><IBody type="e">
				<_bodyData type="a">std::cout &lt;&lt; &quot;DataProcessEngine | Processing Data&quot;;%0D
%0D
RhpString dataWithoutNoise = itsDataFilter.applyNoiseReduction(data);%0D
filteredData = itsDataFilter.removeOutliers(dataWithoutNoise);%0D
%0D
RhpString analyzedData = itsDataAnalyzer.analyzeDataStatistically(filteredData);%0D
prediction = itsDataAnalyzer.runPredictionModels(analyzedData);%0D
risk = itsRiskEvaluator.calculateRisk(prediction);%0D
%0D
itsDataLogger.saveDataAndPrediction(filteredData,prediction);</_bodyData>
			</IBody>
			</_itsBody>
		</IPrimitiveOperation>
